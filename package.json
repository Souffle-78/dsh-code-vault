{
  "name": "dsh-code-vault",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "DSH sidebar panel that saves code blocks from a conversation into a local vault with folders, drafts, a 30-day recycle bin, quick insert (Cmd+Shift+K) and a lightweight editor. Local only, no server.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Souffle-78/dsh-code-vault.git"
  },
  "homepage": "https://github.com/Souffle-78/dsh-code-vault#readme",
  "bugs": {
    "url": "https://github.com/Souffle-78/dsh-code-vault/issues"
  },
  "author": "Souffle-78",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "code",
    "snippets",
    "sidebar"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "assets",
    "screenshots.json",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
