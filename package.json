{
  "name": "dsh-code-vault",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "Collect code blocks from a DSH conversation into a local vault with drafts, nested folders, a code editor with lightweight checks, and one-keystroke insert back into the composer. 把对话里的代码收进本地收藏夹：草稿箱、文件夹分级、带检查的编辑器，一键插回输入框。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Souffle-78/dsh-code-vault.git"
  },
  "homepage": "https://github.com/Souffle-78/dsh-code-vault#readme",
  "bugs": {
    "url": "https://github.com/Souffle-78/dsh-code-vault/issues"
  },
  "author": "Souffle-78",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "code",
    "snippets",
    "sidebar"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "assets",
    "screenshots.json",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
